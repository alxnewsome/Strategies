//@version=6
indicator(title = "CHASES BUY/SELL + ADVANCE DECLINE (Enhanced)", shorttitle = "BUY/SELL + ADD+", precision = 2, overlay = false, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// Enhanced version of Chase's BUY/SELL + ADD indicator. Same core idea and
// defaults (SMA 70 cross for trend signals, RSI 14 80/20 for reversals), with
// these accuracy upgrades:
//   1. ADD (NYSE breadth) now CONFIRMS signals instead of only being plotted.
//   2. Fixed the off-by-one cross check (close[1] was compared to the current
//      SMA) and made buy/sell symmetric (sell used low, buy used close).
//   3. ATR buffer around the SMA with hysteresis: price has to close clearly
//      through the SMA, so chop around the line no longer flips signals.
//   4. The cross candle's high/low has to be taken out within N bars (not only
//      the very next bar) for the trend signal to confirm.
//   5. Reversals are symmetric (sell reversals need a red candle, too), can
//      require ADD to turn, and are graded stronger when ADD was at an extreme.
//   6. Optional RTH-only filter. ADD only exists 09:30–16:00 ET.
//   7. Signals, SMA and bar colors draw on the PRICE chart while ADD stays in
//      its own pane, so neither squashes the other's scale.
//   8. Built-in scorecard: every signal is graded against an ATR target/stop
//      so you can see which settings actually work on your timeframe.
// ─────────────────────────────────────────────────────────────────────────────

string TZ = "America/New_York"

// ── Inputs ───────────────────────────────────────────────────────────────────
grpT = "Trend signals (SMA cross)"
smaLen      = input.int(70, "SMA length", minval = 1, group = grpT)
bufAtr      = input.float(0.10, "Cross buffer (× ATR)", minval = 0.0, step = 0.05, group = grpT, tooltip = "Price has to close this far beyond the SMA to count as a cross. 0 = original behaviour.")
confirmBars = input.int(3, "Bars allowed to confirm", minval = 1, maxval = 20, group = grpT, tooltip = "After the cross candle, price has this many bars to break its high (buy) or low (sell) with a candle in the same direction.")
slopeFilter = input.bool(false, "Require SMA sloping with the signal", group = grpT)
volFilter   = input.bool(false, "Require above-average volume on the signal bar", group = grpT)
volLen      = input.int(20, "Volume average length", minval = 1, group = grpT)

grpR = "Reversal signals (RSI)"
rsiLen    = input.int(14, "RSI length", minval = 1, group = grpR)
rsiUpper  = input.int(80, "RSI upper", minval = 50, maxval = 100, group = grpR)
rsiLower  = input.int(20, "RSI lower", minval = 0, maxval = 50, group = grpR)
revCandle = input.bool(true, "Reversal needs a candle in the reversal direction", group = grpR)

grpA = "ADD (market breadth)"
addSym     = input.symbol("USI:ADD", "Breadth symbol", group = grpA)
addTf      = input.timeframe("", "ADD timeframe (blank = chart)", group = grpA)
addMaLen   = input.int(10, "ADD MA length", minval = 1, group = grpA)
addMode    = input.string("Above/below MA", "ADD confirmation for buy/sell", options = ["Above/below MA", "Above/below MA and rising/falling", "Above/below zero", "Off"], group = grpA)
addRevConf = input.bool(true, "Reversals need ADD turning", group = grpA)
addExtreme = input.int(1000, "ADD extreme level", minval = 100, step = 100, group = grpA, tooltip = "A reversal is graded strong (REV+) when ADD was beyond ± this level in the last 5 bars.")
rthOnly    = input.bool(true, "Signals only during RTH (09:30–16:00 ET)", group = grpA)

grpS = "Scorecard"
showStats = input.bool(true, "Show win-rate scorecard", group = grpS)
tpAtr     = input.float(2.0, "Target (× ATR)", minval = 0.1, step = 0.25, group = grpS)
slAtr     = input.float(1.0, "Stop (× ATR)", minval = 0.1, step = 0.25, group = grpS)
maxHold   = input.int(100, "Give up after (bars)", minval = 5, group = grpS)

// ── Core series ──────────────────────────────────────────────────────────────
float rsi = ta.rsi(close, rsiLen)
float sma = ta.sma(close, smaLen)
float atr = ta.atr(14)
float buf = atr * bufAtr
bool  inRTH = not na(time(timeframe.period, "0930-1600", TZ))
bool  sessOk = not rthOnly or inRTH

// ADD. Outside RTH it's stale, so it doesn't filter there.
float add    = request.security(addSym, addTf, hlc3, ignore_invalid_symbol = true)
float addMa  = ta.sma(add, addMaLen)
bool  addUse = inRTH and not na(add) and not na(addMa)

bool addBullRaw = switch addMode
    "Above/below MA"                    => add > addMa
    "Above/below MA and rising/falling" => add > addMa and add > add[1]
    "Above/below zero"                  => add > 0
    => true
bool addBearRaw = switch addMode
    "Above/below MA"                    => add < addMa
    "Above/below MA and rising/falling" => add < addMa and add < add[1]
    "Above/below zero"                  => add < 0
    => true
bool addBull = not addUse or addBullRaw
bool addBear = not addUse or addBearRaw

// ── Trend signals: buffered SMA cross + confirmation ─────────────────────────
var int side = 0                       // 1 = clearly above SMA, -1 = clearly below
int prevSide = side
if close > sma + buf
    side := 1
else if close < sma - buf
    side := -1
bool crossUp = side == 1 and prevSide == -1
bool crossDn = side == -1 and prevSide == 1

var int   pendDir  = 0
var float pendLvl  = na
var int   pendBar  = na
bool slopeUp  = not slopeFilter or sma > sma[3]
bool slopeDn  = not slopeFilter or sma < sma[3]
float volAvg  = ta.sma(volume, volLen)
bool volOk    = not volFilter or volume > volAvg

bool buySignal  = false
bool sellSignal = false
if pendDir == 1
    if close < sma or bar_index - pendBar > confirmBars
        pendDir := 0
    else if high > pendLvl and close > open and close > sma and addBull and slopeUp and volOk and sessOk
        buySignal := true
        pendDir   := 0
else if pendDir == -1
    if close > sma or bar_index - pendBar > confirmBars
        pendDir := 0
    else if low < pendLvl and close < open and close < sma and addBear and slopeDn and volOk and sessOk
        sellSignal := true
        pendDir    := 0
if crossUp
    pendDir := 1
    pendLvl := high
    pendBar := bar_index
if crossDn
    pendDir := -1
    pendLvl := low
    pendBar := bar_index

// ── Reversal signals: RSI back inside its bands ──────────────────────────────
bool addTurnDn = not addRevConf or not addUse or add < add[1]
bool addTurnUp = not addRevConf or not addUse or add > add[1]
bool revDn = ta.crossunder(rsi, rsiUpper) and (not revCandle or close < open) and addTurnDn and sessOk
bool revUp = ta.crossover(rsi, rsiLower) and (not revCandle or close > open) and addTurnUp and sessOk
float addHi5 = ta.highest(add, 5)
float addLo5 = ta.lowest(add, 5)
bool addWasHigh = addUse and addHi5 >= addExtreme
bool addWasLow  = addUse and addLo5 <= -addExtreme
bool revDnStrong = revDn and addWasHigh
bool revUpStrong = revUp and addWasLow

// ── ADD pane ─────────────────────────────────────────────────────────────────
hline(0, "Zero", color.new(color.gray, 40), hline.style_solid)
hline(addExtreme,  "+Extreme", color.new(color.green, 50), hline.style_dotted)
hline(-addExtreme, "-Extreme", color.new(color.red, 50), hline.style_dotted)
plot(add,   "ADD",    add > add[1] ? color.green : color.red, 3)
plot(addMa, "ADD MA", color.new(#ff9800, 0), 2)
bgcolor(inRTH ? na : color.new(color.gray, 90), title = "Outside RTH (ADD stale)")

// ── Price chart ──────────────────────────────────────────────────────────────
plot(sma, "SMA", sma > sma[1] ? color.new(color.lime, 20) : color.new(color.red, 20), 2, force_overlay = true)

plotshape(buySignal,  "BUY",  shape.labelup,   location.belowbar, color.new(color.green, 0), text = "BUY",  textcolor = color.white, size = size.small, force_overlay = true)
plotshape(sellSignal, "SELL", shape.labeldown, location.abovebar, color.new(color.red, 0),   text = "SELL", textcolor = color.white, size = size.small, force_overlay = true)
plotshape(revDn and not revDnStrong, "Reversal down",          shape.labeldown, location.abovebar, color.new(color.yellow, 20), text = "↓",     textcolor = color.black, size = size.tiny,  force_overlay = true)
plotshape(revUp and not revUpStrong, "Reversal up",            shape.labelup,   location.belowbar, color.new(color.yellow, 20), text = "↑",     textcolor = color.black, size = size.tiny,  force_overlay = true)
plotshape(revDnStrong,               "Reversal down (strong)", shape.labeldown, location.abovebar, color.new(color.yellow, 0),  text = "REV+ ↓", textcolor = color.black, size = size.small, force_overlay = true)
plotshape(revUpStrong,               "Reversal up (strong)",   shape.labelup,   location.belowbar, color.new(color.yellow, 0),  text = "REV+ ↑", textcolor = color.black, size = size.small, force_overlay = true)

barcolor(buySignal ? color.new(color.green, 0) : sellSignal ? color.new(color.maroon, 0) : revDn or revUp ? color.new(color.yellow, 0) : na)

// ── Scorecard: did price hit +target before -stop? ───────────────────────────
type Trade
    int   dir
    int   kind      // 0 = trend, 1 = reversal
    float tp
    float sl
    int   bar

var array<Trade> trades = array.new<Trade>()
var array<int>   wins   = array.from(0, 0)
var array<int>   losses = array.from(0, 0)

if trades.size() > 0
    for i = trades.size() - 1 to 0
        Trade t = trades.get(i)
        bool stopHit = t.dir == 1 ? low <= t.sl : high >= t.sl
        bool tgtHit  = t.dir == 1 ? high >= t.tp : low <= t.tp
        if stopHit                      // stop first if both hit on one bar (conservative)
            losses.set(t.kind, losses.get(t.kind) + 1)
            trades.remove(i)
        else if tgtHit
            wins.set(t.kind, wins.get(t.kind) + 1)
            trades.remove(i)
        else if bar_index - t.bar > maxHold
            trades.remove(i)

addTrade(int dir, int kind) =>
    trades.push(Trade.new(dir, kind, close + dir * tpAtr * atr, close - dir * slAtr * atr, bar_index))

if buySignal
    addTrade(1, 0)
if sellSignal
    addTrade(-1, 0)
if revUp
    addTrade(1, 1)
if revDn
    addTrade(-1, 1)

var table stats = table.new(position.top_right, 4, 3, bgcolor = color.new(color.black, 80), border_width = 1)
statRow(int row, string name, int kind) =>
    int w = wins.get(kind)
    int l = losses.get(kind)
    int n = w + l
    stats.cell(0, row, name, text_color = color.white, text_size = size.small)
    stats.cell(1, row, str.tostring(w) + "W / " + str.tostring(l) + "L", text_color = color.white, text_size = size.small)
    float wr = n > 0 ? 100.0 * w / n : na
    float be = 100.0 * slAtr / (tpAtr + slAtr)
    stats.cell(2, row, n > 0 ? str.tostring(wr, "#.0") + "%" : "–", text_color = n == 0 ? color.gray : wr >= be ? color.lime : color.red, text_size = size.small)
if showStats and barstate.islast
    stats.cell(0, 0, "Signal", text_color = color.white, text_size = size.small)
    stats.cell(1, 0, "Result", text_color = color.white, text_size = size.small)
    stats.cell(2, 0, "Win % (BE " + str.tostring(100.0 * slAtr / (tpAtr + slAtr), "#") + "%)", text_color = color.white, text_size = size.small)
    statRow(1, "BUY/SELL", 0)
    statRow(2, "Reversals", 1)

// ── Alerts ───────────────────────────────────────────────────────────────────
alertcondition(revDn or revUp,          title = "Both Reversal Signal",   message = "Reversal Alert {{ticker}} @ {{close}}")
alertcondition(buySignal or sellSignal, title = "Buy & Sell Signal Both", message = "Buy/Sell Alert {{ticker}} @ {{close}}")
alertcondition(buySignal,               title = "Only Buy Signal",        message = "Buy Alert {{ticker}} @ {{close}}")
alertcondition(sellSignal,              title = "Only Sell Signal",       message = "Sell Alert {{ticker}} @ {{close}}")
alertcondition(revDn,                   title = "Reversal from Top",      message = "Down Reversal Alert {{ticker}} @ {{close}}")
alertcondition(revUp,                   title = "Reversal from Down",     message = "Up Reversal Alert {{ticker}} @ {{close}}")
alertcondition(revDnStrong or revUpStrong, title = "Strong Reversal (ADD extreme)", message = "Strong Reversal Alert {{ticker}} @ {{close}}")
