//@version=6
strategy("Fib Retracement Continuation", shorttitle = "Fib Cont", overlay = true, pyramiding = 3, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.cash_per_contract, commission_value = 2.5, slippage = 1, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// THE IDEA
//  A run of consecutive candles of one colour is an IMPULSE leg. Price usually
//  comes back to REBALANCE part of that leg before it continues.
//    • 0.5        rebalancing level: fills most often, widest stop
//    • 0.618–0.786 the "golden pocket": fills less often, much smaller stop,
//                  much bigger reward:risk
//  Bullish leg (green run) → buy the retracement, stop beyond 1.0 (leg low),
//  target the 0 level (retest of the leg high) or an extension beyond it.
//  Bearish leg (red run) is the mirror image.
//
// MULTI-TIMEFRAME (how you trade 1 / 5 / 15 min)
//  • Bias timeframe (default 15m): only buy when the 15m EMA is rising and price
//    is above it; only sell when it's falling and price is below it.
//  • Leg timeframe (e.g. 5m): where the consecutive-candle impulse is measured.
//  • Chart timeframe (e.g. 1m): where the limit order fills and is managed.
// ─────────────────────────────────────────────────────────────────────────────

string TZ = "America/New_York"

// ── Inputs ───────────────────────────────────────────────────────────────────
grpL = "Impulse leg"
minRun    = input.int(3, "Consecutive candles needed", minval = 2, maxval = 10, group = grpL)
minLegAtr = input.float(1.5, "Min leg size (× ATR)", minval = 0.0, step = 0.25, group = grpL, tooltip = "Filters out tiny runs. ATR is measured on the leg timeframe.")
legTf     = input.timeframe("", "Leg timeframe (blank = chart)", group = grpL, tooltip = "Measure the impulse on a higher timeframe (e.g. 5) while entering on the chart (e.g. 1).")
extendLeg = input.bool(true, "Extend leg if price makes a new extreme before retracing", group = grpL)

grpE = "Entry"
entryMode = input.string("0.618", "Entry level", options = ["0.5", "0.618", "0.786", "Scale in 0.5 / 0.618 / 0.786"], group = grpE)
confirm   = input.bool(false, "Wait for a rejection candle at the level", group = grpE, tooltip = "Off: resting limit order at the level. On: enter at the close of a candle that wicks through the level and closes back on the trend side.")
qtyPer    = input.int(1, "Contracts per entry", minval = 1, group = grpE)

grpX = "Exits"
stopTicks = input.int(4, "Stop buffer beyond the 1.0 level (ticks)", minval = 0, group = grpX)
tgtMode   = input.string("0 (retest of leg extreme)", "Target", options = ["0 (retest of leg extreme)", "-0.272 extension", "-0.618 extension"], group = grpX)
expiry    = input.int(60, "Cancel unfilled setup after (bars)", minval = 5, group = grpX)

grpF = "Filters"
useBias    = input.bool(true, "Higher-timeframe bias filter", group = grpF)
biasTf     = input.timeframe("15", "Bias timeframe", group = grpF)
biasLen    = input.int(21, "Bias EMA length", minval = 1, group = grpF)
useSess    = input.bool(true, "Only trade inside the session", group = grpF)
sess       = input.session("0930-1555", "Session (New York time)", group = grpF)
flatSess   = input.session("1555-1600", "Flatten all (New York time)", group = grpF)
allowLong  = input.bool(true, "Take longs", group = grpF)
allowShort = input.bool(true, "Take shorts", group = grpF)

grpD = "Display"
goldCol = input.color(#ffd600, "Golden pocket (0.618–0.786)", group = grpD)
halfCol = input.color(#ff9800, "0.5 level", group = grpD)
edgeCol = input.color(#9e9e9e, "0 / 1 levels", group = grpD)
sigCol  = input.color(#FFFF00, "Entry candle", group = grpD)

// ── Impulse legs (consecutive candles) ───────────────────────────────────────
// Returns the most recent completed bullish and bearish legs and the time each
// was confirmed. `shift` delays values one bar for non-repainting HTF requests.
legs(int runLen, float minAtr, bool shift) =>
    var int   gRun = 0
    var int   rRun = 0
    var float gLo = na
    var float gHi = na
    var float rLo = na
    var float rHi = na
    var int   bT  = na
    var float bLo = na
    var float bHi = na
    var int   sT  = na
    var float sHi = na
    var float sLo = na
    float a = ta.atr(14)
    bool  g = close > open
    bool  r = close < open
    // A run ends on the first candle that isn't the same colour.
    if not g and gRun >= runLen and gHi - gLo >= minAtr * a
        bT  := time
        bLo := gLo
        bHi := gHi
    if not r and rRun >= runLen and rHi - rLo >= minAtr * a
        sT  := time
        sHi := rHi
        sLo := rLo
    if g
        gLo  := gRun == 0 ? math.min(low, low[1]) : math.min(gLo, low)
        gHi  := gRun == 0 ? high : math.max(gHi, high)
        gRun += 1
    else
        gRun := 0
    if r
        rHi  := rRun == 0 ? math.max(high, high[1]) : math.max(rHi, high)
        rLo  := rRun == 0 ? low : math.min(rLo, low)
        rRun += 1
    else
        rRun := 0
    [shift ? bT[1] : bT, shift ? bLo[1] : bLo, shift ? bHi[1] : bHi, shift ? sT[1] : sT, shift ? sHi[1] : sHi, shift ? sLo[1] : sLo]

[cbT, cbLo, cbHi, csT, csHi, csLo] = legs(minRun, minLegAtr, false)
[hbT, hbLo, hbHi, hsT, hsHi, hsLo] = request.security(syminfo.tickerid, legTf == "" ? timeframe.period : legTf, legs(minRun, minLegAtr, true), lookahead = barmerge.lookahead_on)
bool useHtf = legTf != "" and timeframe.in_seconds(legTf) > timeframe.in_seconds()

int   upT  = useHtf ? hbT  : cbT
float upLo = useHtf ? hbLo : cbLo
float upHi = useHtf ? hbHi : cbHi
int   dnT  = useHtf ? hsT  : csT
float dnHi = useHtf ? hsHi : csHi
float dnLo = useHtf ? hsLo : csLo
bool newBull = not na(upT) and (na(upT[1]) or upT != upT[1])
bool newBear = not na(dnT) and (na(dnT[1]) or dnT != dnT[1])

// ── Filters ──────────────────────────────────────────────────────────────────
[bE, bE1] = request.security(syminfo.tickerid, biasTf, [ta.ema(close, biasLen)[1], ta.ema(close, biasLen)[2]], lookahead = barmerge.lookahead_on)
bool biasLong  = not useBias or (bE > bE1 and close > bE)
bool biasShort = not useBias or (bE < bE1 and close < bE)
bool inWin     = not useSess or not na(time(timeframe.period, sess, TZ))
bool flatNow   = not na(time(timeframe.period, flatSess, TZ))

// ── Setup state ──────────────────────────────────────────────────────────────
var int   dir      = 0      // 1 = long setup, -1 = short setup
var float A        = na     // 1.0 level (leg start)
var float B        = na     // 0 level (leg extreme)
var bool  active   = false
var bool  touched5 = false  // price has reached the 0.5 level
var int   setupBar = na

lvl(float r) => B - r * (B - A)
float ext   = tgtMode == "-0.272 extension" ? 0.272 : tgtMode == "-0.618 extension" ? 0.618 : 0.0
float buf   = stopTicks * syminfo.mintick
float stopPx = A - dir * buf
float tgtPx  = B + ext * (B - A)

array<float> entryR = entryMode == "0.5" ? array.from(0.5) : entryMode == "0.618" ? array.from(0.618) : entryMode == "0.786" ? array.from(0.786) : array.from(0.5, 0.618, 0.786)

// ── Fib drawing ──────────────────────────────────────────────────────────────
var array<float> allR = array.from(0.0, 0.5, 0.618, 0.786, 1.0)
var array<line>  fibL = array.new<line>()
var array<label> fibT = array.new<label>()
var array<box>   gpB  = array.new<box>()

fibColor(float r) => r == 0.5 ? halfCol : (r == 0.618 or r == 0.786) ? goldCol : edgeCol

drawFib() =>
    fibL.clear()
    fibT.clear()
    gpB.clear()
    for r in allR
        float p = lvl(r)
        color c = fibColor(r)
        fibL.push(line.new(setupBar, p, bar_index + 10, p, color = c, width = (r == 0.618 or r == 0.786) ? 2 : 1, style = (r == 0 or r == 1) ? line.style_dotted : line.style_solid))
        fibT.push(label.new(bar_index + 10, p, str.tostring(r) + "  " + str.tostring(p, format.mintick), style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = size.small))
    gpB.push(box.new(setupBar, math.max(lvl(0.618), lvl(0.786)), bar_index + 10, math.min(lvl(0.618), lvl(0.786)), border_color = color.new(goldCol, 100), bgcolor = color.new(goldCol, 85)))

updateFib(bool live) =>
    int xr = live ? bar_index + 10 : bar_index
    for [i, ln] in fibL
        float p = lvl(allR.get(i))
        ln.set_y1(p)
        ln.set_y2(p)
        ln.set_x2(xr)
        fibT.get(i).set_xy(xr, p)
        fibT.get(i).set_text(str.tostring(allR.get(i)) + "  " + str.tostring(p, format.mintick))
    for b in gpB
        b.set_top(math.max(lvl(0.618), lvl(0.786)))
        b.set_bottom(math.min(lvl(0.618), lvl(0.786)))
        b.set_right(xr)

fadeFib() =>
    for ln in fibL
        ln.set_color(color.new(edgeCol, 70))
    for lb in fibT
        lb.set_textcolor(color.new(edgeCol, 70))
    for b in gpB
        b.set_bgcolor(color.new(edgeCol, 92))

// ── Trade logic ──────────────────────────────────────────────────────────────
bool flat = strategy.position_size == 0

// A finished trade clears everything (including unfilled scale-in orders).
if flat and strategy.position_size[1] != 0
    strategy.cancel_all()
    active := false
    updateFib(false)

// New impulse leg → new setup (only while flat).
bool takeBull = newBull and allowLong and biasLong and inWin and flat
bool takeBear = newBear and allowShort and biasShort and inWin and flat
if takeBull and takeBear
    takeBull := false
    takeBear := false
if takeBull or takeBear
    if active
        strategy.cancel_all()
        fadeFib()
    dir      := takeBull ? 1 : -1
    A        := takeBull ? upLo : dnHi
    B        := takeBull ? upHi : dnLo
    active   := true
    touched5 := false
    setupBar := bar_index
    stopPx   := A - dir * buf
    tgtPx    := B + ext * (B - A)
    drawFib()

if active and flat
    // Leg keeps running before any retracement: move the 0 level with it.
    if extendLeg and not touched5 and (dir == 1 ? high > B : low < B)
        B := dir == 1 ? high : low
        tgtPx := B + ext * (B - A)
    if dir == 1 ? low <= lvl(0.5) : high >= lvl(0.5)
        touched5 := true
    updateFib(true)

    bool broken  = dir == 1 ? close < A : close > A
    bool expired = bar_index - setupBar > expiry
    if broken or expired or not inWin
        strategy.cancel_all()
        active := false
        fadeFib()
    else
        for r in entryR
            float  p  = lvl(r)
            string id = "Fib " + str.tostring(r)
            if confirm
                bool rejected = dir == 1 ? (low <= p and close > p and close > open) : (high >= p and close < p and close < open)
                if rejected
                    strategy.entry(id, dir == 1 ? strategy.long : strategy.short, qty = qtyPer)
            else
                strategy.entry(id, dir == 1 ? strategy.long : strategy.short, qty = qtyPer, limit = p)
            strategy.exit(id + " exit", id, stop = stopPx, limit = tgtPx)
else if active
    updateFib(true)

if flatNow and (strategy.position_size != 0 or active)
    strategy.close_all("EOD flat")
    strategy.cancel_all()
    if active
        active := false
        updateFib(false)

// ── Visuals ──────────────────────────────────────────────────────────────────
bool filled = math.abs(strategy.position_size) > math.abs(strategy.position_size[1])
barcolor(filled ? sigCol : na, title = "Entry candle")
bool inTrade = strategy.position_size != 0
plot(inTrade ? stopPx : na, "Stop",   color.new(#f23645, 0), 2, plot.style_linebr)
plot(inTrade ? tgtPx  : na, "Target", color.new(#089981, 0), 2, plot.style_linebr)
plot(useBias ? bE : na, "Bias EMA", color.new(#90a4ae, 40), 1, plot.style_stepline)

// ── Results table ────────────────────────────────────────────────────────────
var table perf = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 75), border_width = 1)
if barstate.islast
    int   n  = strategy.closedtrades
    int   w  = strategy.wintrades
    int   l  = strategy.losstrades
    float wr = n > 0 ? 100.0 * w / n : na
    float pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    perf.cell(0, 0, "Fib " + entryMode, text_color = color.white, text_size = size.small)
    perf.cell(1, 0, "", text_size = size.small)
    perf.cell(0, 1, "Trades", text_color = color.white, text_size = size.small)
    perf.cell(1, 1, str.tostring(n), text_color = color.white, text_size = size.small)
    perf.cell(0, 2, "Win / Loss", text_color = color.white, text_size = size.small)
    perf.cell(1, 2, str.tostring(w) + " / " + str.tostring(l), text_color = color.white, text_size = size.small)
    perf.cell(0, 3, "Win rate", text_color = color.white, text_size = size.small)
    perf.cell(1, 3, n > 0 ? str.tostring(wr, "#.0") + "%" : "–", text_color = n > 0 and wr >= 50 ? color.lime : color.orange, text_size = size.small)
    perf.cell(0, 4, "Profit factor", text_color = color.white, text_size = size.small)
    perf.cell(1, 4, na(pf) ? "–" : str.tostring(pf, "#.00"), text_color = na(pf) ? color.gray : pf >= 1 ? color.lime : color.red, text_size = size.small)
    perf.cell(0, 5, "Net P&L ($)", text_color = color.white, text_size = size.small)
    perf.cell(1, 5, str.tostring(strategy.netprofit, "#,###"), text_color = strategy.netprofit >= 0 ? color.lime : color.red, text_size = size.small)

alertcondition(takeBull, "Bullish fib setup", "Bullish impulse on {{ticker}}: watch 0.5 / 0.618 / 0.786 for a long")
alertcondition(takeBear, "Bearish fib setup", "Bearish impulse on {{ticker}}: watch 0.5 / 0.618 / 0.786 for a short")
alertcondition(filled,   "Fib entry filled",  "Fib entry filled on {{ticker}} @ {{close}}")
