//@version=6
indicator("Opening Price Sweep", shorttitle = "Open Sweep", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// Marks when price SWEEPS the day's opening price: it trades through the open
// to grab the stops resting there, then closes back on the side it came from.
//
//  Bullish sweep ▲: price was holding ABOVE the open, wicks BELOW it, and closes
//                   back above. Sellers got trapped and buy stops were taken.
//  Bearish sweep ▼: price was holding BELOW the open, wicks ABOVE it, and closes
//                   back below.
//
// "Holding above/below" means price first moved at least `Move away` × ATR
// from the open, so normal chop around the open at the bell isn't flagged.
// Works on any stock, ETF or future: the opening price comes from the symbol's
// own regular session (09:30 ET for US stocks).
// ─────────────────────────────────────────────────────────────────────────────

anchor    = input.string("Regular session open", "Opening price", options = ["Regular session open", "Full session open (incl. pre-market)"])
excAtr    = input.float(1.0, "Move away before a sweep counts (× ATR)", minval = 0.0, step = 0.25)
penTicks  = input.int(1, "Min wick through the open (ticks)", minval = 0)
maxBeyond = input.int(0, "Closes allowed past the open", minval = 0, maxval = 10, tooltip = "0 = wick-only sweeps. 1–3 also counts a failed break: price closes past the open for up to this many bars, then closes back.")
maxPerDay = input.int(2, "Max sweeps per day (each direction)", minval = 1)
rthOnly   = input.bool(true, "Only during regular trading hours")
atrLen    = input.int(14, "ATR length", minval = 1)
openCol   = input.color(#ffffff, "Opening price line")
bullCol   = input.color(#00e676, "Bullish sweep")
bearCol   = input.color(#ff5252, "Bearish sweep")
sigCol    = input.color(#FFFF00, "Sweep candle")

if not timeframe.isintraday
    runtime.error("Opening Price Sweep needs an intraday chart.")

float atr = ta.atr(atrLen)
float pen = penTicks * syminfo.mintick
bool  newSess = anchor == "Regular session open" ? session.isfirstbar_regular : session.isfirstbar

var float O       = na
var line  oLine   = na
var int   side    = 0      // 1 = holding above the open, -1 = holding below, 0 = undecided
var int   beyond  = 0      // consecutive closes past the open while a sweep is in progress
var int   bullCnt = 0
var int   bearCnt = 0

bool bullSweep = false
bool bearSweep = false

if newSess
    O       := open
    side    := 0
    beyond  := 0
    bullCnt := 0
    bearCnt := 0
    oLine   := line.new(bar_index, O, bar_index + 1, O, color = openCol, width = 2)
    label.new(bar_index, O, "Open " + str.tostring(O, format.mintick), style = label.style_label_right, color = color.new(color.black, 100), textcolor = openCol, size = size.small)
else if not na(O) and (not rthOnly or session.ismarket)
    float exc = excAtr * atr
    if side == 0
        if close - O >= exc
            side := 1
        else if O - close >= exc
            side := -1
    else if side == 1
        if low <= O - pen or beyond > 0
            if close > O
                if bullCnt < maxPerDay
                    bullSweep := true
                    bullCnt   += 1
                side   := 0         // needs a fresh move away before the next one
                beyond := 0
            else
                beyond += 1
                if beyond > maxBeyond   // stayed below: a real break, not a sweep
                    side   := 0
                    beyond := 0
    else
        if high >= O + pen or beyond > 0
            if close < O
                if bearCnt < maxPerDay
                    bearSweep := true
                    bearCnt   += 1
                side   := 0
                beyond := 0
            else
                beyond += 1
                if beyond > maxBeyond
                    side   := 0
                    beyond := 0

if not na(oLine)
    oLine.set_x2(bar_index + 1)

if bullSweep
    label.new(bar_index, low, "Open sweep ▲", yloc = yloc.belowbar, style = label.style_label_up, color = bullCol, textcolor = color.black, size = size.small)
    alert("Bullish sweep of the open on " + syminfo.ticker + " (open " + str.tostring(O, format.mintick) + ", close " + str.tostring(close, format.mintick) + ")", alert.freq_once_per_bar_close)
if bearSweep
    label.new(bar_index, high, "Open sweep ▼", yloc = yloc.abovebar, style = label.style_label_down, color = bearCol, textcolor = color.white, size = size.small)
    alert("Bearish sweep of the open on " + syminfo.ticker + " (open " + str.tostring(O, format.mintick) + ", close " + str.tostring(close, format.mintick) + ")", alert.freq_once_per_bar_close)

barcolor(bullSweep or bearSweep ? sigCol : na, title = "Sweep candle")

alertcondition(bullSweep, "Bullish open sweep", "Bullish sweep of the opening price on {{ticker}} @ {{close}}")
alertcondition(bearSweep, "Bearish open sweep", "Bearish sweep of the opening price on {{ticker}} @ {{close}}")
alertcondition(bullSweep or bearSweep, "Any open sweep", "Opening price swept on {{ticker}} @ {{close}}")
plot(bullSweep ? 1 : bearSweep ? -1 : 0, "Sweep (1 bull / -1 bear)", display = display.data_window)
